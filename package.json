{
  "name": "warrant",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "An agent that has to earn the right to move money.",
  "scripts": {
    "verify": "node verify/run-all.mjs",
    "verify:stripe": "node verify/stripe-refund.mjs",
    "verify:github": "node verify/github-issue.mjs",
    "verify:slack": "node verify/slack-post.mjs",
    "verify:lemma": "node verify/lemma-trace.mjs",
    "start": "node src/server.js",
    "fixtures": "node fixtures/build.mjs --all",
    "llm:ping": "node -e \"import('./src/llm.js').then(m=>m.ping().then(console.log))\"",
    "verify:llm": "node verify/llm-provider.mjs",
    "lemma:policy": "node scripts/upload-policy.mjs",
    "verify:injection": "node verify/injection.mjs",
    "graph": "node scripts/print-graph.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test:ui": "playwright test",
    "test:frontend-server": "node --test tests/frontend-server.test.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.3.2",
    "@hugeicons/react": "^1.1.10",
    "@langchain/core": "^1.2.11",
    "@langchain/langgraph": "^1.4.15",
    "@slack/web-api": "^7.8.0",
    "@uselemma/tracing": "^7.12.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^16.4.7",
    "motion": "^13.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "stripe": "^17.5.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "engines": {
    "node": ">=22.12"
  }
}
