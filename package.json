{
  "name": "warrant",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "An agent that has to earn the right to move money.",
  "scripts": {
    "verify": "node verify/run-all.mjs",
    "verify:stripe": "node verify/stripe-refund.mjs",
    "verify:github": "node verify/github-issue.mjs",
    "verify:slack": "node verify/slack-post.mjs",
    "verify:lemma": "node verify/lemma-trace.mjs",
    "start": "node src/server.js",
    "start:demo": "WARRANT_DB=data/warrant-live-demo.db WARRANT_PROVIDER=live WARRANT_DEMO=s1 node src/server.js",
    "demo:prepare": "WARRANT_DB=data/warrant-live-demo.db WARRANT_PROVIDER=live WARRANT_DEMO=s1 node scripts/prepare-live-demo.mjs",
    "start:demo:sqlite": "WARRANT_DB=data/warrant-demo.db WARRANT_PROVIDER=sqlite node src/server.js",
    "demo:prepare:sqlite": "WARRANT_DB=data/warrant-demo.db WARRANT_PROVIDER=sqlite node scripts/prepare-demo.mjs",
    "fixtures": "node fixtures/build.mjs --all",
    "llm:ping": "node -e \"import('./src/llm.js').then(m=>m.ping().then(console.log))\"",
    "verify:llm": "node verify/llm-provider.mjs",
    "lemma:policy": "node scripts/upload-policy.mjs",
    "verify:injection": "node verify/injection.mjs",
    "graph": "node scripts/print-graph.mjs",
    "fixtures:demo": "node fixtures/build.mjs --demo",
    "test": "node --experimental-test-module-mocks --test test/*.test.mjs",
    "lemma:issues": "node scripts/lemma-issues.mjs",
    "journal:reconcile": "node scripts/reconcile-operation.mjs",
    "history:archive": "node scripts/archive-history.mjs",
    "engine:build": "tsc -p engines/hmem/tsconfig.build.json",
    "engine:conformance": "HMEM_IMPL=/Users/adokiye/hacks/warrant/engines/hmem/src/index.ts tsx engines/hmem/conformance/runner.ts",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@langchain/core": "^1.2.11",
    "@langchain/langgraph": "^1.4.15",
    "@langchain/langgraph-checkpoint": "1.1.5",
    "@slack/web-api": "^7.8.0",
    "@uselemma/tracing": "^7.12.0",
    "dotenv": "^16.4.7",
    "pg": "^8.23.1",
    "stripe": "^17.5.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "5.9"
  }
}
