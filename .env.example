# Stripe — test mode only. Dashboard > Developers > API keys (toggle Test mode).
# MUST start with sk_test_ . The verify script refuses anything else.
STRIPE_SECRET_KEY=sk_test_

# GitHub — a classic PAT with `repo` scope, on a throwaway repo you own.
# https://github.com/settings/tokens
GITHUB_TOKEN=
GITHUB_REPO=your-username/warrant-billing-cases

# Slack — bot token from a test workspace app, scope: chat:write
# https://api.slack.com/apps > OAuth & Permissions
SLACK_BOT_TOKEN=xoxb-
# Quote the channel — dotenv reads an unquoted leading # as a comment.
SLACK_CHANNEL="#billing-approvals"

# Optional: set to point adapters at an Arga twin instead of the real service.
# Leave blank for real test-mode services.
SLACK_API_URL=

# Lemma — platform.uselemma.ai
LEMMA_API_KEY=
LEMMA_PROJECT_ID=

# OpenAI-compatible LLM. Works with any gateway that speaks /chat/completions.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# llm = use the model above; rules = deterministic engine, no model call
LLM_MODE=llm
