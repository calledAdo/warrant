# Stripe — test mode only. Dashboard > Developers > API keys (toggle Test mode).
# MUST start with sk_test_ . The verify script refuses anything else.
STRIPE_SECRET_KEY=sk_test_

# GitHub — a classic PAT with `repo` scope, on a throwaway repo you own.
# https://github.com/settings/tokens
GITHUB_TOKEN=
GITHUB_REPO=your-username/warrant-billing-cases

# Slack — bot token from a test workspace app, scope: chat:write
# https://api.slack.com/apps > OAuth & Permissions
SLACK_BOT_TOKEN=xoxb-
# Quote the channel — dotenv reads an unquoted leading # as a comment.
SLACK_CHANNEL="#billing-approvals"

# Optional: set to point adapters at an Arga twin instead of the real service.
# Leave blank for real test-mode services.
SLACK_API_URL=

# Lemma — platform.uselemma.ai
LEMMA_API_KEY=
LEMMA_PROJECT_ID=

# OpenAI-compatible LLM. Works with any gateway that speaks /chat/completions.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# llm = use the model above; rules = deterministic engine, no model call
LLM_MODE=llm

# Optional: stop on model failure instead of using the shared rules fallback.
LLM_FALLBACK=on

# Durable complaints, runs, approvals, journal and graph checkpoints.
WARRANT_DB=data/warrant.db

# live = Stripe/GitHub/Slack; sqlite = repeatable local S1 demo provider.
WARRANT_PROVIDER=live
# Set by start:demo; limits demo routes and fixture data to S1.
WARRANT_DEMO=

# ---------------------------------------------------------------------------
# Open Agent Hackathon extension — Warrant Remembers
# These are also wired through "npm run sync-env" (copies values from the
# Lotline .env, names printed only, never the values).
# ---------------------------------------------------------------------------

# Zetaris evidence layer: REST SQL endpoint + org + admin API key (setup only).
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=

# Nightshift (Meterless) OpenAI-compatible provider for every model call.
# Models are pinned by name in src/llm.js — NVIDIA Nemotron only.
METERLESS_BASE_URL=
METERLESS_RUNTIME_TOKEN=
WARRANT_METERLESS_APP_ID=warrant
# Lanes: NIGHTSHIFT_FAST_MODE for extraction/mentions, NIGHTSHIFT_DEEP_MODE for
# judgement. Pin the NVIDIA Nemotron models; never meterless/fast or meterless/deep.
NIGHTSHIFT_FAST_MODE=nvidia/nemotron-3.5-lightning-30b-a3b
NIGHTSHIFT_DEEP_MODE=nvidia/nemotron-3-ultra-550b-a55b

# S3 (SeaweedFS) — bucket `lotline`, prefix warrant/, for evidence snapshots.
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Postgres `warrant` database (existing lotline-hospital-db-1 container).
WARRANT_DB_USER=
WARRANT_DB_PASSWORD=

# Zetaris read-only principals (least privilege, wr_ prefix). Passwords are
# generated locally by scripts/setup-zetaris.mjs and never committed.
ZETARIS_WR_EVIDENCE_USER=wr_evidence@local.test
ZETARIS_WR_EVIDENCE_PASSWORD=
ZETARIS_WR_HISTORY_USER=wr_history@local.test
ZETARIS_WR_HISTORY_PASSWORD=

